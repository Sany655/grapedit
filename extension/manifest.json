{
   "action": {
      "default_popup": "popup.html"
   },
   "background": {
      "service_worker": "service-worker.js"
   },
   "content_scripts": [
      {
         "all_frames": false,
         "js": [
            "js/router.js"
         ],
         "matches": [
            "https://grapedit.vercel.app/*",
            "http://localhost:3000/*"
         ],
         "run_at": "document_end"
      },
      {
         "all_frames": false,
         "js": [
            "js/content.js"
         ],
         "matches": [
            "https://grapedit.vercel.app/*",
            "http://localhost:3000/*"
         ],
         "run_at": "document_end"
      },
      {
         "all_frames": true,
         "exclude_matches": [
            "https://grapedit.vercel.app/*",
            "http://localhost:3000/*"
         ],
         "js": [
            "js/injection.js"
         ],
         "matches": [
            "*://*/*"
         ],
         "run_at": "document_start"
      }
   ],
   "default_locale": "en",
   "description": "__MSG_manifest_description__",
   "homepage_url": "http://localhost:3000/",
   "host_permissions": [
      "https://*/*",
      "http://*/*"
   ],
   "manifest_version": 3,
   "minimum_chrome_version": "92",
   "name": "GrapEdit",
   "permissions": [
      "tabs",
      "webRequest",
      "storage",
      "declarativeNetRequest",
      "offscreen",
      "scripting"
   ],
   "short_name": "GrapEdit",
   "version": "1.0",
   "web_accessible_resources": [
      {
         "matches": [
            "<all_urls>"
         ],
         "resources": [
            "js/hook.js",
            "js/mediabunny.js",
            "img/recording.svg"
         ]
      }
   ]
}